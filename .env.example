# Environment Configuration

# Application Environment
ENV=local
DEBUG=false
LOG_LEVEL=INFO

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vector Database
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma_db

# Storage Configuration
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=./data/uploads

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.5
MAX_CHUNKS_PER_DOCUMENT=20000

# Request Configuration
MAX_UPLOAD_SIZE_MB=50
REQUEST_TIMEOUT_SECONDS=300
MAX_FILE_SIZE_MB=512
MAX_UPLOAD_STREAM_CHUNK_KB=1024

# Ingestion Throughput and Resilience
VECTOR_UPSERT_BATCH_SIZE=128
INGESTION_WORKERS=4
EMBEDDING_WORKERS=4
MAX_BATCH_FILES_PER_REQUEST=1000
MAX_PARALLEL_FILE_INGESTIONS=4
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF_SECONDS=1.0

# PDF Processing Controls
PDF_EXTRACT_TABLES=true
PDF_EXTRACT_IMAGES_TEXT=true
PDF_OCR_ENABLED=false

# Database Configuration (optional, for future PostgreSQL support)
# DATABASE_URL=postgresql://user:password@localhost:5432/rag_embeddings
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=rag_embeddings
